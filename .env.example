# 복사해서 .env 로 저장하세요. 값이 비어 있는 증권사는 목업 데이터로 동작합니다.
# .env 는 절대 커밋하지 마세요 (.gitignore 에 포함됨).

PORT=8787
FX_USDKRW=1390

# 키움증권 REST API (openapi.kiwoom.com 에서 신청, 서버 고정 IP 등록 필요)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_MOCK=false          # true 면 모의투자 서버(mockapi.kiwoom.com)
KIWOOM_ACCOUNT_LABEL=위탁

# 토스증권 Open API (토스증권 WTS > 설정 > Open API 에서 발급, 허용 IP 등록 필요)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_ID=
TOSS_ACCOUNT_LABEL=종합

# 신한투자증권: 공식 REST 없음 → data/shinhan.json 파일 사용 시 file
SHINHAN_SOURCE=
